# Copy to .env (never commit .env)
GEMINI_API_KEY=
# Run `npm --prefix server run models` to see which models your key can use; pick a Flash model (accepts audio).
GEMINI_MODEL=gemini-2.5-flash
# Optional: a second model tried only if the primary keeps failing with 503/429/5xx/timeout or is not found (404).
GEMINI_FALLBACK_MODEL=
PORT=3000
